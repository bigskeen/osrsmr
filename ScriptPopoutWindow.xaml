<Window x:Class="OsrsMr.ScriptPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSRSMR Script Controller &amp; Options" Height="740" Width="680"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        MinWidth="540" MinHeight="580">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#888888"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Banner -->
            <RowDefinition Height="*"/>    <!-- Config Form & Tabs -->
            <RowDefinition Height="Auto"/> <!-- Telemetry & Controls -->
        </Grid.RowDefinitions>

        <!-- Top Script Banner -->
        <Border Grid.Row="0" Background="#282828" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#3A3A3C" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock x:Name="PopoutScriptNameText" Text="Visual Auto Fighter" FontSize="16" FontWeight="Bold" Foreground="#00E5FF"/>
                    <TextBlock x:Name="PopoutScriptDescText" Text="Attacks monsters, eats food, and loots drops from custom drop tables." FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1" x:Name="PopoutCategoryBadge" Background="#B71C1C" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                    <TextBlock x:Name="PopoutCategoryText" Text="Combat" FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Author: " Foreground="Gray" FontSize="10"/>
                    <TextBlock x:Name="PopoutAuthorText" Text="User" Foreground="#CCCCCC" FontSize="10" Margin="0,0,12,0"/>
                    <TextBlock Text="Version: " Foreground="Gray" FontSize="10"/>
                    <TextBlock x:Name="PopoutVersionText" Text="1.0.0" Foreground="#CCCCCC" FontSize="10" Margin="0,0,12,0"/>
                    <TextBlock Text="Total Steps: " Foreground="Gray" FontSize="10"/>
                    <TextBlock x:Name="PopoutStepsCountText" Text="3 Steps" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center: Scrollable Configuration & Combat Looting Hub -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel x:Name="PopoutConfigContainer">

                <!-- Monster Selection & Loot Table Hub (Active for Combat scripts or selectable) -->
                <GroupBox Header="Monster Targeting &amp; Drop Table Loot Selector" Foreground="#FFD700" BorderBrush="#444448" Margin="0,0,0,10">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Target Monster & Food Settings -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Target Monster Name:" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="PopoutTargetMonsterBox" Text="Goblin" TextChanged="PopoutTargetMonsterBox_TextChanged" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Food Name in Inventory:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="PopoutFoodNameBox" Text="Trout" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Eat at HP %:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="PopoutEatHpBox" Text="50" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: 3-Column Box (Nearby Monsters, Monster Loot Table, Active Loot List) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Nearby Monsters Detected -->
                            <GroupBox Grid.Column="0" Header="Nearby Monsters / NPCs" Foreground="White" BorderBrush="#3A3A3C" Margin="0,0,4,0">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="PopoutNearbyNpcsList" Grid.Row="0" SelectionChanged="PopoutNearbyNpcsList_SelectionChanged" Background="#181818" BorderBrush="#333333">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Distance, StringFormat='({0})'}" Foreground="Gray" FontSize="10"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="1" Content="Scan Nearby NPCs" Click="PopoutScanNpcsBtn_Click" Background="#333333" Foreground="White" FontSize="10" Padding="6,2" Margin="0,4,0,0"/>
                                </Grid>
                            </GroupBox>

                            <!-- Column 2: Monster Drop Table Items -->
                            <GroupBox Grid.Column="1" Header="Monster Drop Table" Foreground="White" BorderBrush="#3A3A3C" Margin="2,0,4,0">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="PopoutLootTableList" Grid.Row="0" SelectionMode="Extended" Background="#181818" BorderBrush="#333333">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" Foreground="White" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Rarity}" Foreground="#FFD700" FontSize="9" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Content="+ Add Selected" Click="PopoutAddSelectedLoot_Click" Background="#287233" Foreground="White" FontWeight="Bold" FontSize="10" Padding="6,2" Margin="0,0,3,0"/>
                                        <Button Content="Add All Herbs" Click="PopoutAddHerbsLoot_Click" Background="#388E3C" Foreground="White" FontSize="10" Padding="5,2" Margin="0,0,3,0"/>
                                        <Button Content="Add 100%" Click="PopoutAddAlwaysLoot_Click" Background="#007ACC" Foreground="White" FontSize="10" Padding="5,2"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Column 3: Active Loot List -->
                            <GroupBox Grid.Column="2" Header="Active Loot List" Foreground="White" BorderBrush="#3A3A3C" Margin="2,0,0,0">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox x:Name="PopoutActiveLootList" Grid.Row="0" Background="#181818" BorderBrush="#333333">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button Content="Remove" Click="PopoutRemoveLootItem_Click" Background="#8B1E1E" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,3,0"/>
                                        <Button Content="Clear All" Click="PopoutClearLootList_Click" Background="#444444" Foreground="White" FontSize="10" Padding="6,2"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>

                        <!-- Row 2: Custom Item Adder -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PopoutCustomLootItemBox" Text="" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="+ Add Custom Item to Loot List" Click="PopoutAddCustomLootItem_Click" Background="#287233" Foreground="White" FontWeight="Bold" Padding="8,3" FontSize="11"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Banking Options Section -->
                <Border Background="#252528" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#444448" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Banking Settings &amp; Dropdown Options" Foreground="#FFD700" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Banking Routine / Mode:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <ComboBox x:Name="PopoutBankingModeComboBox" Margin="0,3,0,0">
                                    <ComboBoxItem Content="None (Power Drop / Fast Drop)"/>
                                    <ComboBoxItem Content="Deposit All Items" IsSelected="True"/>
                                    <ComboBoxItem Content="Deposit All Except Tools"/>
                                    <ComboBoxItem Content="Deposit Loot &amp; Restock Food"/>
                                    <ComboBoxItem Content="Deposit Loot &amp; Withdraw Teleport"/>
                                    <ComboBoxItem Content="Custom Bank Sequence"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bank Trigger:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <ComboBox x:Name="PopoutBankTriggerComboBox" Margin="0,3,0,0">
                                    <ComboBoxItem Content="When Inventory Full" IsSelected="True"/>
                                    <ComboBoxItem Content="When Out of Food"/>
                                    <ComboBoxItem Content="When Low HP (&lt;30%)"/>
                                    <ComboBoxItem Content="Periodic (Every 15m)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Keep in Inventory (e.g. axe, pickaxe, food):" Foreground="Gray" FontSize="10"/>
                                <TextBox x:Name="PopoutBankKeepItemsBox" Text="Trout, sword" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Withdraw Item &amp; Qty:" Foreground="Gray" FontSize="10"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PopoutBankWithdrawItemBox" Text="Trout" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" x:Name="PopoutBankWithdrawQtyBox" Text="10" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="3,3" TextAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dynamic Fields List Container -->
                <StackPanel x:Name="DynamicFieldsListPanel"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Telemetry & Controls Area -->
        <Border Grid.Row="2" Background="#252528" CornerRadius="8" Padding="10" BorderBrush="#3A3A3C" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status & Stats Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="PopoutStatusBadge" Background="#424242" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                        <TextBlock x:Name="PopoutStatusBadgeText" Text="STOPPED" FontWeight="Bold" FontSize="11" Foreground="#CCCCCC"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Task: " Foreground="Gray" FontSize="11"/>
                        <TextBlock x:Name="PopoutActiveStepText" Text="Idle / Ready" Foreground="#00E5FF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Runtime: " Foreground="Gray" FontSize="11"/>
                        <TextBlock x:Name="PopoutRuntimeText" Text="00:00:00" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock Text="Loops: " Foreground="Gray" FontSize="11"/>
                        <TextBlock x:Name="PopoutLoopsText" Text="0" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons (Start / Pause / Stop / Save) -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Start Bot" Click="PopoutStartBtn_Click" Background="#2E7D32" Foreground="White" FontWeight="Bold" Padding="8,6" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="Pause" Click="PopoutPauseBtn_Click" Background="#F57F17" Foreground="Black" FontWeight="Bold" Padding="8,6" Margin="2,0,4,0"/>
                    <Button Grid.Column="2" Content="Stop" Click="PopoutStopBtn_Click" Background="#C62828" Foreground="White" FontWeight="Bold" Padding="8,6" Margin="2,0,4,0"/>
                    <Button Grid.Column="3" Content="Save Options" Click="PopoutSaveBtn_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="8,6" Margin="2,0,0,0"/>
                </Grid>

                <!-- Mini Console / Output -->
                <TextBox Grid.Row="2" x:Name="PopoutLogBox" Height="65" Background="#141414" Foreground="#81C784" 
                         FontFamily="Consolas" FontSize="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" BorderBrush="#333333" Padding="4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
