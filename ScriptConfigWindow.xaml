<Window x:Class="osrsmr.ScriptConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script Setup &amp; Configuration" 
        Height="620" Width="520" 
        MinWidth="440" MinHeight="480"
        Background="#181818" 
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    
    <Window.Resources>
        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Dark Styling -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#252526"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0E639C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Script Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Settings Form Content -->
            <RowDefinition Height="*"/>
            <!-- 2. Action Buttons Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Script Header Banner -->
        <Border Grid.Row="0" Background="#202024" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="18" Foreground="#FFD700" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScriptNameText" Text="Script Name" FontSize="17" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ScriptAuthorText" Text="by Author • v1.0.0" FontSize="11" Foreground="#888888" Margin="26,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" x:Name="CategoryBadge" Background="#2C313A" BorderBrush="#61AFEF" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                        <TextBlock x:Name="ScriptCategoryText" Text="GENERAL" Foreground="#61AFEF" FontWeight="Bold" FontSize="10"/>
                    </Border>
                </Grid>

                <!-- Description box -->
                <TextBlock x:Name="ScriptDescriptionText" Grid.Row="1" Text="Script description goes here." Foreground="#B0B0B0" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Dynamic Settings Scroll Area -->
        <Border Grid.Row="1" Background="#202024" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SettingsFormPanel" Margin="4">
                    <!-- Dynamically generated controls will be placed here -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons Footer -->
        <Border Grid.Row="2" Background="#202024" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Reset button -->
                <Button Grid.Column="0" x:Name="ResetDefaultsBtn" Content="↺ Reset Defaults" Background="#2A2A2A" Foreground="#CCCCCC" Click="ResetDefaultsBtn_Click"/>

                <!-- Right action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SaveApplyBtn" Content="💾 Save &amp; Apply" Background="#1B4D3E" Foreground="#A3E4D7" Click="SaveApplyBtn_Click"/>
                    <Button x:Name="StartBotBtn" Content="▶ Start Bot Now" Background="#1E5E2B" Foreground="#85E89D" FontWeight="Bold" Padding="16,6" Click="StartBotBtn_Click"/>
                    <Button x:Name="CloseBtn" Content="✖ Close" Background="#3A3A3C" Foreground="#E0E0E0" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
