<Window x:Class="osrsmr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osrsmr" Height="600" Width="900" Background="#1E1E1E"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="osrsmr Bridge" FontSize="18" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center" Margin="0,0,20,0"/>
            
            <Button x:Name="AttachButton" Content="Attach to Game" Click="AttachButton_Click" Padding="15,5" Margin="0,0,10,0" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="Launch RuneLite" Click="LaunchButton_Click" Padding="12,5" Margin="0,0,10,0" Background="#287233" Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="Close RuneLite" Click="CloseRuneLite_Click" Padding="12,5" Margin="0,0,10,0" Background="#8B1E1E" Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="#555555"/>
            <Button Content="View Logs" Click="ViewLogs_Click" Padding="10,5" Margin="0,0,20,0" FontSize="11"/>

            <TextBlock Text="Status:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="StatusLabel" Text="Waiting to Attach..." Foreground="Yellow" FontWeight="Bold" VerticalAlignment="Center"/>
            
            <Separator Visibility="Hidden" Width="20"/>
            
            <Button Content="Fix Shortcuts" Click="RepairConfig_Click" Margin="10,0,0,0" Padding="10,2" FontSize="10"/>
        </StackPanel>

        <!-- Main Left Content: Live Data -->
        <TabControl Grid.Row="1" Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" Margin="0,0,10,0">
            <TabItem Header="Player Info">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Player Name:" Foreground="Gray" FontSize="10"/>
                        <TextBlock x:Name="PlayerNameText" Text="Unknown" Foreground="#007ACC" FontSize="16" FontWeight="Bold"/>
                        
                        <TextBlock Text="Location:" Foreground="Gray" FontSize="10" Margin="0,5,0,0"/>
                        <TextBlock x:Name="PlayerLocationText" Text="0, 0, 0" Foreground="White"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Tab:" Foreground="Gray" FontSize="10"/>
                                <TextBlock x:Name="ActiveTabText" Text="Inventory" Foreground="#FFD700" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Magic Spellbook:" Foreground="Gray" FontSize="10"/>
                                <Border x:Name="PlayerSpellbookBadge" Background="#1E392A" CornerRadius="4" Padding="6,2" Margin="0,2,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="PlayerSpellbookText" Text="Standard" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Quick Combat & Dialog Summary -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Special Attack:" Foreground="Gray" FontSize="10"/>
                                <TextBlock x:Name="PlayerSpecText" Text="100%" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Slayer Task:" Foreground="Gray" FontSize="10"/>
                                <TextBlock x:Name="PlayerSlayerText" Text="None" Foreground="#FFA726" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Chat Dialog:" Foreground="Gray" FontSize="10"/>
                                <Border x:Name="PlayerDialogBadge" Background="#2A2A2A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock x:Name="PlayerDialogBadgeText" Text="Inactive" Foreground="Gray" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Agility, Minigames & Fishing Summary -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Agility Course:" Foreground="Gray" FontSize="10"/>
                                <TextBlock x:Name="PlayerAgilityText" Text="None" Foreground="#81C784" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Minigame:" Foreground="Gray" FontSize="10"/>
                                <TextBlock x:Name="PlayerMinigameText" Text="None" Foreground="#BA68C8" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fishing Spots:" Foreground="Gray" FontSize="10"/>
                                <TextBlock x:Name="PlayerFishingText" Text="0 Nearby" Foreground="#4DD0E1" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#3F3F46" Margin="0,5"/>

                    <GroupBox Grid.Row="2" Header="Skills" Foreground="White" BorderBrush="#3F3F46">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SkillsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Foreground="White"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="99" Height="15" Background="#3E3E42" Foreground="#007ACC"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Combat &amp; Slayer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Special Attack Group -->
                        <GroupBox Grid.Row="0" Header="Special Attack" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Energy:" Foreground="Gray" FontSize="11"/>
                                    <ProgressBar x:Name="SpecProgressBar" Value="100" Maximum="100" Height="20" Background="#2A2A38" Foreground="#00E5FF" Margin="0,4,10,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Status:" Foreground="Gray" FontSize="11"/>
                                    <Border x:Name="SpecActiveBadge" Background="#2A2A2A" CornerRadius="4" Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="SpecActiveText" Text="Inactive" Foreground="Gray" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock x:Name="SpecPercentText" Grid.Row="1" Grid.Column="0" Text="100% Special Attack Energy" Foreground="#00E5FF" FontSize="11" Margin="0,4,0,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- Slayer Assignment Group -->
                        <GroupBox Grid.Row="1" Header="Slayer Assignment" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                    <TextBlock Text="Current Task Monster:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="SlayerTaskText" Text="None" Foreground="#FFA726" FontWeight="Bold" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Remaining Kills:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="SlayerCountText" Text="0" Foreground="#00E5FF" FontWeight="Bold" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                                    <TextBlock Text="Slayer Points:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="SlayerPointsText" Text="0" Foreground="#FFD700" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Task Streak:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="SlayerStreakText" Text="0 Tasks Completed" Foreground="White" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <TextBlock Text="Nearby Slayer Master:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="SlayerMasterNearbyText" Text="None in range" Foreground="#81C784" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Chat &amp; Dialog">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Active Dialog Box -->
                    <GroupBox Grid.Row="0" Header="Active Game Dialogue" Foreground="White" BorderBrush="#3F3F46" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DialogTypeBadge" Grid.Column="0" Background="#2A2A2A" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock x:Name="DialogTypeText" Text="No Active Dialogue" Foreground="Gray" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <TextBlock x:Name="DialogTitleText" Grid.Column="1" Text="" Foreground="#FFD700" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0" MinHeight="70">
                                <TextBlock x:Name="DialogContentText" Text="No dialog currently open in the game client." Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel x:Name="DialogOptionsPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <TextBlock Text="Dialogue Options:" Foreground="Gray" FontSize="10" Margin="0,0,0,4"/>
                                <Border Background="#182535" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <TextBlock x:Name="DialogOptionsText" Text="" Foreground="#00E5FF" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="World &amp; Objects">
                <TabControl Background="#1E1E1E" BorderBrush="#3F3F46" Margin="5">
                    <TabItem Header="Trees">
                        <ListView x:Name="TreesList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Tree Type" DisplayMemberBinding="{Binding Name}" Width="140"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Banks">
                        <ListView x:Name="BanksList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Bank Object" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="General Stores">
                        <ListView x:Name="ShopsList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Shop / Stall" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Altars &amp; Pools">
                        <ListView x:Name="AltarsList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Altar / Pool" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Mining Rocks">
                        <ListView x:Name="RocksList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Rock Type" DisplayMemberBinding="{Binding Name}" Width="140"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Shortcuts">
                        <ListView x:Name="WorldShortcutsList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Shortcut Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                    <GridViewColumn Header="Req Level" DisplayMemberBinding="{Binding ReqLevel}" Width="70"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Course Obstacles">
                        <ListView x:Name="WorldAgilityObstaclesList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Obstacle" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                    <GridViewColumn Header="Course" DisplayMemberBinding="{Binding Course}" Width="140"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Ground Items">
                        <ListView x:Name="GroundItemsList" Background="#252526" Foreground="White" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="140"/>
                                    <GridViewColumn Header="Qty" DisplayMemberBinding="{Binding Quantity}" Width="50"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Agility &amp; Shortcuts">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Course Overview Box -->
                    <GroupBox Grid.Row="0" Header="Current Agility Course" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Course:" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="AgilityCourseText" Text="None" Foreground="#81C784" FontWeight="Bold" FontSize="15" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="20,0,20,0">
                                <TextBlock Text="Required Level:" Foreground="Gray" FontSize="11"/>
                                <TextBlock x:Name="AgilityCourseLevelText" Text="-" Foreground="#FFD700" FontWeight="Bold" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Marks of Grace:" Foreground="Gray" FontSize="11"/>
                                <Border Background="#3B2A1E" CornerRadius="4" Padding="8,2" Margin="0,2,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="MarksOfGraceText" Text="0 Nearby" Foreground="#FFA726" FontWeight="Bold" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <TabControl Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46">
                        <TabItem Header="Shortcuts in Range">
                            <ListView x:Name="ShortcutsList" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                        <GridViewColumn Header="Shortcut Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                        <GridViewColumn Header="Required Level" DisplayMemberBinding="{Binding ReqLevel}" Width="100"/>
                                        <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="70"/>
                                        <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>

                        <TabItem Header="Course Obstacles">
                            <ListView x:Name="AgilityObstaclesList" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                        <GridViewColumn Header="Obstacle Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                        <GridViewColumn Header="Associated Course" DisplayMemberBinding="{Binding Course}" Width="170"/>
                                        <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="70"/>
                                        <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Fishing Spots">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Fishing Overview" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1E2F3A" CornerRadius="4" Padding="8,4" Margin="0,0,15,0">
                                <TextBlock x:Name="FishingSpotsSummaryText" Text="0 Fishing Spots Detected" Foreground="#4DD0E1" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <TextBlock Text="Automatic fish type &amp; method resolution (Net, Harpoon, Cage, Fly Fishing, Bait)" Foreground="Gray" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <ListView x:Name="FishingSpotsList" Grid.Row="1" Background="#252526" Foreground="White" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                <GridViewColumn Header="Spot Name" DisplayMemberBinding="{Binding Name}" Width="140"/>
                                <GridViewColumn Header="Fish Type &amp; Method" DisplayMemberBinding="{Binding SpotType}" Width="260"/>
                                <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="70"/>
                                <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Minigames">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Active Minigame Card -->
                        <GroupBox Grid.Row="0" Header="Active Minigame &amp; Activity" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                    <TextBlock Text="Minigame:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="MinigameNameText" Text="None" Foreground="#BA68C8" FontWeight="Bold" FontSize="16" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Activity Status:" Foreground="Gray" FontSize="11"/>
                                    <Border x:Name="MinigameActiveBadge" Background="#2A2A2A" CornerRadius="4" Padding="8,3" Margin="0,2,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="MinigameActiveText" Text="Inactive" Foreground="Gray" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                                    <TextBlock Text="Current Phase / State:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="MinigameStatusText" Text="Inactive" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Points / Score / Zeal:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="MinigamePointsText" Text="0" Foreground="#FFD700" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <TextBlock Text="Details &amp; Objectives:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="MinigameExtraText" Text="No minigame currently detected" Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Supported Minigames Information -->
                        <GroupBox Grid.Row="1" Header="Supported Minigames &amp; Raids" Foreground="White" BorderBrush="#3F3F46" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Automatic detection and telemetry for:" Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Text="• Pest Control (Lander boat, game instance, shield values, commendation points)&#x0a;• Wintertodt (Warmth percentage, points, pyromancers)&#x0a;• Tempoross (Storm intensity, energy, essence, points)&#x0a;• Guardians of the Rift (Rift status, cell energy, catalytic/elemental)&#x0a;• Barbarian Assault (Roles, waves 1-10, call horn telemetry)&#x0a;• Castle Wars (Saradomin / Zamorak score, game timer)&#x0a;• Soul Wars (Avatar health, zeal points)&#x0a;• Blast Furnace (Coffer, temperature, ore stores)&#x0a;• Barrows (Brothers slain, reward potential)&#x0a;• Fight Caves / Inferno / Fortis Colosseum (Wave tracking)&#x0a;• Tithe Farm, Volcanic Mine, Mage Training Arena, Mahogany Homes, Last Man Standing (LMS) &amp; Raids (CoX, ToB, ToA)" Foreground="#D4D4D4" FontSize="11" LineHeight="18"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Bank &amp; Stores">
                <TabControl Background="#1E1E1E" BorderBrush="#3F3F46" Margin="5">
                    <TabItem Header="Bank Contents">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border x:Name="BankOpenBadge" Background="#2A2A2A" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock x:Name="BankOpenText" Text="Bank Closed" Foreground="Gray" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="BankItemCountText" Text="0 Items Loaded" Foreground="#FFD700" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <ListView x:Name="BankContainerList" Grid.Row="1" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                                        <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                        <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" Width="90"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="General Store">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border x:Name="ShopOpenBadge" Background="#2A2A2A" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock x:Name="ShopOpenText" Text="Store Closed" Foreground="Gray" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="ShopTitleText" Text="General Store" Foreground="#00E5FF" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ShopItemCountText" Text="0 Items In Stock" Foreground="#FFD700" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <ListView x:Name="ShopContainerList" Grid.Row="1" Background="#252526" Foreground="White" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                                        <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                        <GridViewColumn Header="Stock Quantity" DisplayMemberBinding="{Binding Quantity}" Width="90"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            
            <TabItem Header="Nearby NPCs">
                <ListView x:Name="NpcList" Background="#252526" Foreground="White" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="140"/>
                            <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="100"/>
                            <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="60"/>
                            <GridViewColumn Header="Health" DisplayMemberBinding="{Binding Health}" Width="60"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="Nearby Players">
                <ListView x:Name="PlayerList" Background="#252526" Foreground="White" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                            <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="80"/>
                            <GridViewColumn Header="Combat Level" DisplayMemberBinding="{Binding CombatLevel}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="Equipment">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Equipment Slots Layout -->
                    <Border x:Name="Equip_Head" Grid.Row="0" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Head"/>
                    
                    <Border x:Name="Equip_Cape" Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Cape"/>
                    <Border x:Name="Equip_Neck" Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Neck"/>
                    <Border x:Name="Equip_Ammo" Grid.Row="1" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Ammo"/>

                    <Border x:Name="Equip_Weapon" Grid.Row="2" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Weapon"/>
                    <Border x:Name="Equip_Body" Grid.Row="2" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Body"/>
                    <Border x:Name="Equip_Shield" Grid.Row="2" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Shield"/>

                    <Border x:Name="Equip_Legs" Grid.Row="3" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Legs"/>

                    <Border x:Name="Equip_Hands" Grid.Row="4" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Hands"/>
                    <Border x:Name="Equip_Feet" Grid.Row="4" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Feet"/>
                    <Border x:Name="Equip_Ring" Grid.Row="4" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Background="#2A2A2A" ToolTip="Ring"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Magic &amp; Prayers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Magic / Spellbook Group -->
                        <GroupBox Grid.Row="0" Header="Magic &amp; Spellbook" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                    <TextBlock Text="Active Spellbook:" Foreground="Gray" FontSize="11"/>
                                    <Border x:Name="SpellbookBadge" Background="#1E392A" CornerRadius="4" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="SpellbookText" Text="Standard" Foreground="#4CAF50" FontWeight="Bold" FontSize="13"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Autocast Spell:" Foreground="Gray" FontSize="11"/>
                                    <Border x:Name="AutocastBadge" Background="#2A2A3A" CornerRadius="4" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="AutocastSpellText" Text="None" Foreground="#82AAFF" FontWeight="Bold" FontSize="13"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <TextBlock Text="Selected / Target Spell:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="SelectedSpellText" Text="None" Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Prayers Overview Group -->
                        <GroupBox Grid.Row="1" Header="Prayer Status" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                    <TextBlock Text="Quick Prayers:" Foreground="Gray" FontSize="11"/>
                                    <Border x:Name="QuickPrayerBadge" Background="#2A2A2A" CornerRadius="4" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="QuickPrayerText" Text="Inactive" Foreground="Gray" FontWeight="Bold" FontSize="13"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Active Prayers Count:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="ActivePrayerCountText" Text="0 Active" Foreground="#FFD700" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <TextBlock Text="Currently Active:" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="ActivePrayersListText" Text="None" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- All Prayers Live Detection -->
                        <GroupBox Grid.Row="2" Header="All Prayers (Live Detection)" Foreground="White" BorderBrush="#3F3F46" Padding="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                                <ItemsControl x:Name="PrayersControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="135" Margin="3" Padding="6,4" CornerRadius="4" 
                                                    Background="{Binding BackgroundBrush}" 
                                                    BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding StatusBrush}"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding TextBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Bot Controller">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Script Control Toolbar -->
                    <GroupBox Grid.Row="0" Header="Script Manager" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Select Bot:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <ComboBox x:Name="BotSelectorComboBox" Width="260" SelectionChanged="BotSelectorComboBox_SelectionChanged" Background="#F0F0F0" Foreground="Black" FontWeight="SemiBold" BorderBrush="#555555">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="PopoutCurrentScriptBtn" Content="Pop Out Script Options" Click="PopoutCurrentScriptBtn_Click" Background="#4A148C" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0"/>
                                <Button x:Name="StartBotBtn" Content="Start Script" Click="StartBotBtn_Click" Background="#287233" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="0,0,6,0"/>
                                <Button x:Name="PauseBotBtn" Content="Pause" Click="PauseBotBtn_Click" Background="#7F6000" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0" IsEnabled="False"/>
                                <Button x:Name="StopBotBtn" Content="Stop Script" Click="StopBotBtn_Click" Background="#8B1E1E" Foreground="White" FontWeight="Bold" Padding="12,5" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Script Telemetry & Status Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Status -->
                        <Border Grid.Column="0" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,0,6,0" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ENGINE STATUS" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <Border x:Name="BotStatusBadge" Background="#3A2A2A" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="BotStatusText" Text="STOPPED" Foreground="#E57373" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Runtime -->
                        <Border Grid.Column="1" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,0,6,0" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RUNTIME" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BotRuntimeText" Text="00:00:00" Foreground="#00E5FF" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Cycles -->
                        <Border Grid.Column="2" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,0,6,0" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="LOOP TICKS" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BotCyclesText" Text="0 cycles" Foreground="#FFD700" FontWeight="Bold" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Action -->
                        <Border Grid.Column="3" Background="#2D2D30" CornerRadius="6" Padding="10" BorderBrush="#3F3F46" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CURRENT TASK" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="BotTaskText" Text="Idle" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bot Console / Execution Log -->
                    <GroupBox Grid.Row="2" Header="Script Console Output" Foreground="White" BorderBrush="#3F3F46">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="BotConsoleTextBox" Grid.Row="0" Background="#181818" Foreground="#A9B7C6" 
                                     FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                     HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Padding="8"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <Button Content="Clear Console" Click="ClearBotConsole_Click" Padding="8,2" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Script Creator" x:Name="ScriptCreatorTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Metadata Bar -->
                        <RowDefinition Height="Auto"/> <!-- AI Assistant Expander -->
                        <RowDefinition Height="Auto"/> <!-- Visual Auto Fighter Drop Table Hub -->
                        <RowDefinition Height="Auto"/> <!-- Quick Banking Bar -->
                        <RowDefinition Height="*"/>    <!-- Center Body (Steps + Editor) -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Toolbar -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Script Metadata & Preset Loader -->
                    <Border Grid.Row="0" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#3F3F46" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Script Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                                <TextBlock Text="Script Name:" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                <TextBox x:Name="CreatorScriptNameBox" Text="My Custom Power Chopper" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,6">
                                <TextBlock Text="Category:" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
                                <ComboBox x:Name="CreatorCategoryComboBox" Background="#F0F0F0" Foreground="Black" Margin="0,3,0,0" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Woodcutting" IsSelected="True"/>
                                    <ComboBoxItem Content="Mining"/>
                                    <ComboBoxItem Content="Combat"/>
                                    <ComboBoxItem Content="Magic"/>
                                    <ComboBoxItem Content="Agility"/>
                                    <ComboBoxItem Content="Fishing"/>
                                    <ComboBoxItem Content="Utility"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Loop Speed (Delays) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,6">
                                <TextBlock Text="Loop Delay (ms):" Foreground="Gray" FontSize="11" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBox x:Name="CreatorMinDelayBox" Text="600" Width="42" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="3,2" TextAlignment="Center"/>
                                    <TextBlock Text="-" Foreground="Gray" VerticalAlignment="Center" Margin="3,0"/>
                                    <TextBox x:Name="CreatorMaxDelayBox" Text="1200" Width="42" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="3,2" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <ComboBox x:Name="CreatorTemplatesComboBox" Width="140" Background="#F0F0F0" Foreground="Black" Margin="0,0,6,0">
                                    <ComboBoxItem Content="Visual Power Chopper" IsSelected="True"/>
                                    <ComboBoxItem Content="Visual Power Miner"/>
                                    <ComboBoxItem Content="Visual Auto Fighter"/>
                                    <ComboBoxItem Content="Visual Loot Collector"/>
                                    <ComboBoxItem Content="Visual High Alcher"/>
                                </ComboBox>
                                <Button Content="Load Template" Click="LoadTemplateBtn_Click" Background="#3E3E42" Foreground="White" FontWeight="Bold" Padding="8,4" Margin="0,0,6,0"/>
                                <Button Content="AI Assistant" Click="OpenAiAssistantBtn_Click" Background="#6A1B9A" Foreground="White" FontWeight="Bold" Padding="8,4" Margin="0,0,6,0"/>
                                <Button Content="Pop Out UI" Click="PopoutCreatorScriptBtn_Click" Background="#00838F" Foreground="White" FontWeight="Bold" Padding="12,4"/>
                            </StackPanel>

                            <!-- Description / Notes -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,2,0,0">
                                <TextBlock Text="Description:" Foreground="Gray" FontSize="10"/>
                                <TextBox x:Name="CreatorDescBox" Text="Custom Script." Background="#1E1E1E" Foreground="#A9B7C6" BorderBrush="#444444" Padding="4,2" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- AI Assistant Panel -->
                    <Border x:Name="AiAssistantPanel" Grid.Row="1" Visibility="Collapsed" Background="#1E1E2E" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#7B1FA2" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="AI SCRIPT GENERATOR &amp; ASSISTANT" Foreground="#E1BEE7" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="(Generate complex bots using ChatGPT / Claude prompt template)" Foreground="#B39DDB" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕ Close" Click="CloseAiAssistantBtn_Click" Background="#3E3E42" Foreground="White" FontSize="10" Padding="8,2"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="1. Copy AI Prompt Template" Click="CopyAiPromptBtn_Click" Background="#4A148C" Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="2. Paste from Clipboard" Click="PasteAiScriptBtn_Click" Background="#283593" Foreground="White" FontSize="10" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="Upload Script File" Click="UploadAiScriptBtn_Click" Background="#37474F" Foreground="White" FontSize="10" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="3. Import &amp; Pop Out UI" Click="ImportAiScriptAndPopoutBtn_Click" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="10" Padding="12,4"/>
                            </StackPanel>

                            <TextBox x:Name="AiScriptInputBox" Grid.Row="2" Height="90" Background="#121218" Foreground="#CE93D8" FontFamily="Consolas" FontSize="10" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderBrush="#4A148C" Padding="6"/>
                        </Grid>
                    </Border>

                    <!-- Visual Auto Fighter: Monster Selector & Drop Table Looting Hub -->
                    <Border Grid.Row="2" Background="#26221E" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#5D4037" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="VISUAL AUTO FIGHTER &amp; MONSTER DROP TABLES" Foreground="#FFD700" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="(Select nearby monster, pick items from its loot table, and add to loot list)" Foreground="#BCAAA4" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Apply Loot to Steps" Click="CreatorApplyCombatLootToSteps_Click" Background="#E65100" Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,3"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Box 1: Nearby Monsters -->
                                <GroupBox Grid.Column="0" Header="1. Nearby Monsters" Foreground="White" BorderBrush="#4E342E" Margin="0,0,4,0">
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="CreatorNearbyNpcsList" Grid.Row="0" SelectionChanged="CreatorNearbyNpcsList_SelectionChanged" Background="#181818" BorderBrush="#333333">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Distance, StringFormat='({0})'}" Foreground="Gray" FontSize="10"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Grid.Row="1" Content="Scan Nearby Monsters" Click="CreatorScanNearbyNpcs_Click" Background="#3E2723" Foreground="White" FontSize="10" Padding="6,2" Margin="0,3,0,0"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Box 2: Monster Drop Table Items -->
                                <GroupBox Grid.Column="1" Header="2. Monster Drop Table" Foreground="White" BorderBrush="#4E342E" Margin="2,0,4,0">
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="CreatorLootTableList" Grid.Row="0" SelectionMode="Extended" Background="#181818" BorderBrush="#333333">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" Foreground="White" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Rarity}" Foreground="#FFD700" FontSize="9" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                            <Button Content="+ Add Selected" Click="CreatorAddSelectedLoot_Click" Background="#287233" Foreground="White" FontWeight="Bold" FontSize="10" Padding="6,2" Margin="0,0,3,0"/>
                                            <Button Content="+ Herbs" Click="CreatorAddHerbsLoot_Click" Background="#388E3C" Foreground="White" FontSize="10" Padding="5,2" Margin="0,0,3,0"/>
                                            <Button Content="+ 100%" Click="CreatorAddAlwaysLoot_Click" Background="#007ACC" Foreground="White" FontSize="10" Padding="5,2"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Box 3: Active Loot List -->
                                <GroupBox Grid.Column="2" Header="3. Active Loot List" Foreground="White" BorderBrush="#4E342E" Margin="2,0,0,0">
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="CreatorActiveLootList" Grid.Row="0" Background="#181818" BorderBrush="#333333">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CreatorCustomLootBox" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="4,2" FontSize="10" Margin="0,0,3,0"/>
                                            <Button Grid.Column="1" Content="+ Add" Click="CreatorAddCustomLootItem_Click" Background="#287233" Foreground="White" FontSize="10" Padding="5,2" Margin="0,0,3,0"/>
                                            <Button Grid.Column="2" Content="Del" Click="CreatorRemoveLootItem_Click" Background="#8B1E1E" Foreground="White" FontSize="10" Padding="5,2"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Quick Banking Options Toolbar -->
                    <Border Grid.Row="3" Background="#252528" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" BorderBrush="#3F3F46" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Quick Banking Action:" Foreground="#FFD700" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="QuickBankingOptionsComboBox" Width="200" Background="#F0F0F0" Foreground="Black" Margin="0,0,4,0">
                                    <ComboBoxItem Content="Open Nearest Bank" IsSelected="True"/>
                                    <ComboBoxItem Content="Bank: Deposit All Items"/>
                                    <ComboBoxItem Content="Bank: Deposit All Except Tools"/>
                                    <ComboBoxItem Content="Bank: Deposit Equipment"/>
                                    <ComboBoxItem Content="Bank: Withdraw Item"/>
                                    <ComboBoxItem Content="Bank: Withdraw ALL"/>
                                    <ComboBoxItem Content="Bank: Withdraw All-But-1"/>
                                    <ComboBoxItem Content="Bank: Close Interface"/>
                                </ComboBox>
                                <Button Content="+ Add Step" Click="AddQuickBankingStep_Click" Background="#287233" Foreground="White" FontWeight="Bold" FontSize="10" Padding="8,3"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Banking Routine Presets:" Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="QuickBankingPresetsComboBox" Width="220" Background="#F0F0F0" Foreground="Black" Margin="0,0,4,0">
                                    <ComboBoxItem Content="Full Bank (Open -> Deposit All -> Close)" IsSelected="True"/>
                                    <ComboBoxItem Content="Keep Tools (Open -> Deposit All Except -> Close)"/>
                                    <ComboBoxItem Content="Combat Restock (Open -> Deposit Loot -> Withdraw Food -> Close)"/>
                                </ComboBox>
                                <Button Content="Insert Routine" Click="InsertBankingRoutineBtn_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="10" Padding="8,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Center Body: 2 Columns (Action Steps List on Left, Step Configurator on Right) -->
                    <Grid Grid.Row="4" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Action Steps Sequence -->
                        <GroupBox Grid.Column="0" Header="Script Action Steps (Executed Top to Bottom)" Foreground="White" BorderBrush="#3F3F46" Margin="0,0,6,0">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="CreatorStepsListBox" Grid.Row="0" Background="#181818" BorderBrush="#333333" 
                                         SelectionChanged="CreatorStepsListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2" Padding="6,4" Background="#282828" CornerRadius="4" BorderBrush="#444448" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Content="Move Up" Click="MoveUpStepBtn_Click" Padding="8,3" Margin="0,0,4,0" FontSize="10"/>
                                    <Button Content="Move Down" Click="MoveDownStepBtn_Click" Padding="8,3" Margin="0,0,4,0" FontSize="10"/>
                                    <Button Content="Delete Step" Click="DeleteStepBtn_Click" Background="#8B1E1E" Padding="8,3" Margin="0,0,4,0" FontSize="10"/>
                                    <Button Content="Clear All" Click="ClearStepsBtn_Click" Padding="8,3" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Right Column: Step Configurator Form -->
                        <GroupBox Grid.Column="1" Header="Action Step Editor" Foreground="White" BorderBrush="#3F3F46" Margin="6,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Step Title -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="Step Title / Name:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                        <TextBox x:Name="StepTitleBox" Text="Chop Nearest Tree" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Trigger Condition -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Trigger Condition:" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                                            <ComboBox x:Name="StepConditionComboBox" Background="#F0F0F0" Foreground="Black" Margin="0,2,0,0" Width="140" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="Always" IsSelected="True"/>
                                                <ComboBoxItem Content="If Inventory Full"/>
                                                <ComboBoxItem Content="If Inventory Not Full"/>
                                                <ComboBoxItem Content="If Has Item in Inv"/>
                                                <ComboBoxItem Content="If Does NOT Have Item"/>
                                                <ComboBoxItem Content="If Player is Idle"/>
                                                <ComboBoxItem Content="If Player Animating"/>
                                                <ComboBoxItem Content="If HP % Below"/>
                                                <ComboBoxItem Content="If Prayer Below"/>
                                                <ComboBoxItem Content="If Bank is Open"/>
                                                <ComboBoxItem Content="If Bank is Closed"/>
                                                <ComboBoxItem Content="If Dialog Open"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Condition Parameter (Item/HP %):" Foreground="Gray" FontSize="10"/>
                                            <TextBox x:Name="StepConditionArgBox" Text="" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Action Type -->
                                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                        <TextBlock Text="Action Type:" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                                        <ComboBox x:Name="StepActionTypeComboBox" SelectionChanged="StepActionTypeComboBox_SelectionChanged" Background="#F0F0F0" Foreground="Black" Margin="0,2,0,0" Width="250" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Chop Tree / Object" IsSelected="True"/>
                                            <ComboBoxItem Content="Mine Rock"/>
                                            <ComboBoxItem Content="Click / Interact Object"/>
                                            <ComboBoxItem Content="Attack NPC"/>
                                            <ComboBoxItem Content="Talk / Click NPC"/>
                                            <ComboBoxItem Content="Drop Item"/>
                                            <ComboBoxItem Content="Drop All Except Items"/>
                                            <ComboBoxItem Content="Eat Food"/>
                                            <ComboBoxItem Content="Clean Grimy Herb"/>
                                            <ComboBoxItem Content="Use Item On Item"/>
                                            <ComboBoxItem Content="Loot Ground Item"/>
                                            <ComboBoxItem Content="Bank: Open Nearest Booth/Chest/NPC"/>
                                            <ComboBoxItem Content="Bank: Deposit All Items"/>
                                            <ComboBoxItem Content="Bank: Deposit All Except"/>
                                            <ComboBoxItem Content="Bank: Deposit Equipment"/>
                                            <ComboBoxItem Content="Bank: Withdraw Item"/>
                                            <ComboBoxItem Content="Bank: Withdraw ALL"/>
                                            <ComboBoxItem Content="Bank: Withdraw All-But-1"/>
                                            <ComboBoxItem Content="Bank: Close Interface"/>
                                            <ComboBoxItem Content="Magic: Cast Spell on Item"/>
                                            <ComboBoxItem Content="Magic: Cast Teleport"/>
                                            <ComboBoxItem Content="Agility: Traverse Obstacle"/>
                                            <ComboBoxItem Content="Dialog: Continue (Space)"/>
                                            <ComboBoxItem Content="Dialog: Select Option"/>
                                            <ComboBoxItem Content="Wait / Delay"/>
                                            <ComboBoxItem Content="Wait Until Player Idle"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Target Name & Action Verb -->
                                    <Grid Grid.Row="3" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock x:Name="StepTargetLabel" Text="Target Object / Entity Name:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                            <TextBox x:Name="StepTargetNameBox" Text="Tree" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="StepVerbLabel" Text="Action Verb:" Foreground="Gray" FontSize="10" FontWeight="Bold"/>
                                            <TextBox x:Name="StepActionVerbBox" Text="Chop down" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Parameter 1 & Parameter 2 -->
                                    <Grid Grid.Row="4" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock x:Name="StepParam1Label" Text="Secondary Param (Item/Opt #):" Foreground="Gray" FontSize="10"/>
                                            <TextBox x:Name="StepParam1Box" Text="" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Post-Action Delay (ms):" Foreground="Gray" FontSize="10"/>
                                            <TextBox x:Name="StepWaitBox" Text="1200" Background="#1E1E1E" Foreground="White" BorderBrush="#555555" Padding="5,3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Buttons: Add / Update -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="+ Add as New Step" Click="AddStepBtn_Click" Background="#287233" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="0,0,8,0"/>
                                        <Button Content="Update Selected Step" Click="UpdateStepBtn_Click" Background="#3E3E42" Foreground="White" FontWeight="Bold" Padding="12,5"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>

                    <!-- Bottom Toolbar: Save, Test, Export C#, Pop Out UI -->
                    <Border Grid.Row="5" Background="#2D2D30" CornerRadius="6" Padding="10" BorderBrush="#3F3F46" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="Save &amp; Load into Script Manager" Click="SaveScriptBtn_Click" Background="#287233" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Pop Out Script Options" Click="PopoutCreatorScriptBtn_Click" Background="#4A148C" Foreground="White" FontWeight="Bold" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="Export to C#" Click="ExportCSharpBtn_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="Test Selected Step" Click="TestStepBtn_Click" Background="#7F6000" Foreground="White" FontWeight="Bold" Padding="10,6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Saved Scripts:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="SavedScriptsComboBox" Width="160" Background="#F0F0F0" Foreground="Black" SelectionChanged="SavedScriptsComboBox_SelectionChanged" Margin="0,0,6,0"/>
                                <Button Content="Delete Script" Click="DeleteSavedScriptBtn_Click" Background="#8B1E1E" Foreground="White" Padding="8,4" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Data">
                <ListView x:Name="DataList" Background="#252526" Foreground="White" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Attribute" DisplayMemberBinding="{Binding Key}" Width="150"/>
                            <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="200"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <!-- Right Side: Inventory Grid (4x8) -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Inventory" Foreground="White" BorderBrush="#3F3F46">
            <Grid x:Name="InventoryGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5">
                <!-- Columns: 4 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <!-- Rows: 8 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                
                <!-- Inventory slots will be populated programmatically or added here -->
            </Grid>
        </GroupBox>

        <!-- Footer / Controls -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Update Stats" Click="RestartHook_Click" Margin="0,0,10,0"/>
            <Button Content="Clear Logs" Click="ClearLogs_Click" Margin="0,0,10,0"/>
            <Button Content="Reset Bridge" Background="#4E1E1E" Click="RestartHook_Click"/>
        </StackPanel>
    </Grid>
</Window>
