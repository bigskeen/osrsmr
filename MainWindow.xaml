<Window x:Class="osrsmr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osrsmr Client Bridge &amp; Automation Studio" Height="780" Width="1180" MinHeight="650" MinWidth="950"
        Background="#141418" Foreground="#E0E0E0"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#454558"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#454558"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#323240"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="Foreground" Value="#A0A0B0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#323240" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#262634"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#1A1A22"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#323240"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#262634"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#323240"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1C1C24" BorderBrush="#323240" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Brand & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="osrsmr" FontSize="20" FontWeight="ExtraBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    <Border Background="#252535" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v2.0 Client Bridge" FontSize="10" FontWeight="Bold" Foreground="#A0A0B8"/>
                    </Border>
                </StackPanel>

                <!-- Connection Status Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="#121218" BorderBrush="#323240" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status: " Foreground="#8E8E9E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusLabel" Text="Waiting to Attach..." Foreground="#FFD700" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Live Quick Character Info in Header -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="#252535" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Player: " Foreground="#8E8E9E" FontSize="11"/>
                            <TextBlock x:Name="PlayerNameText" Text="Unknown" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#252535" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Location: " Foreground="#8E8E9E" FontSize="11"/>
                            <TextBlock x:Name="PlayerLocationText" Text="Unknown" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#252535" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tab: " Foreground="#8E8E9E" FontSize="11"/>
                            <TextBlock x:Name="ActiveTabText" Text="Inventory" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PlayerSpellbookBadge" Background="#1E392A" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="PlayerSpellbookText" Text="Standard" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Control Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AttachButton" Content="Attach to Game" Click="AttachButton_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="12,5" Margin="0,0,4,0"/>
                    <Button Content="Launch RuneLite" Click="LaunchButton_Click" Background="#287233" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,4,0"/>
                    <Button Content="Close Client" Click="CloseRuneLite_Click" Background="#8B1E1E" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,4,0"/>
                    <Button Content="Fix Config" Click="RepairConfig_Click" Padding="8,5" Margin="0,0,4,0"/>
                    <Button Content="Logs" Click="ViewLogs_Click" Padding="8,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LEFT CONTENT TABS (Clean 8 Tabs) -->
        <TabControl Grid.Row="1" Grid.Column="0" Background="#1C1C24" BorderBrush="#323240" Margin="0,0,10,0">

            <!-- TAB 1: PLAYER & COMBAT -->
            <TabItem Header="Player &amp; Combat">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Summary & Vitals Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Health -->
                        <Border Grid.Column="0" Background="#252535" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Hitpoints" Foreground="#F87171" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerHealthText" Text="0 / 0 (100%)" Foreground="White" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PlayerHealthBar" Height="10" Minimum="0" Maximum="99" Value="99" Foreground="#F87171" Background="#3A2020" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Prayer -->
                        <Border Grid.Column="1" Background="#252535" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Prayer" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerPrayerText" Text="0 / 0 (100%)" Foreground="White" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PlayerPrayerBar" Height="10" Minimum="0" Maximum="99" Value="99" Foreground="#60A5FA" Background="#202A3A" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Run Energy -->
                        <Border Grid.Column="2" Background="#252535" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Run Energy" Foreground="#FBBF24" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerEnergyText" Text="100%" Foreground="White" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PlayerEnergyBar" Height="10" Minimum="0" Maximum="100" Value="100" Foreground="#FBBF24" Background="#3A3220" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Special Attack -->
                        <Border Grid.Column="3" Background="#252535" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Special Attack" Foreground="#34D399" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="PlayerSpecText" Text="100%" Foreground="White" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PlayerSpecBar" Height="10" Minimum="0" Maximum="100" Value="100" Foreground="#34D399" Background="#203A28" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Center: Character Detail & Equipment Paperdoll -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Combat & State Detail -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <StackPanel>
                                <GroupBox Header="Combat State &amp; Target">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Combat Status: " Foreground="#8E8E9E" FontSize="11" Margin="0,2"/>
                                        <Border x:Name="PlayerCombatBadge" Grid.Row="0" Grid.Column="1" Background="#2A2A35" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,2">
                                            <TextBlock x:Name="PlayerCombatText" Text="Out of Combat" Foreground="#A0A0B0" FontWeight="Bold" FontSize="11"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target NPC / Player: " Foreground="#8E8E9E" FontSize="11" Margin="0,2"/>
                                        <TextBlock x:Name="PlayerTargetText" Grid.Row="1" Grid.Column="1" Text="None" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" Margin="0,2"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Health: " Foreground="#8E8E9E" FontSize="11" Margin="0,2"/>
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
                                            <ProgressBar x:Name="CombatTargetHealthBar" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#F87171" Background="#332222" BorderThickness="0"/>
                                            <TextBlock x:Name="CombatTargetHealthText" Text="No Target" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Animation / State: " Foreground="#8E8E9E" FontSize="11" Margin="0,2"/>
                                        <TextBlock x:Name="PlayerAnimationText" Grid.Row="3" Grid.Column="1" Text="Idle (-1)" Foreground="#FFD700" FontSize="11" Margin="0,2"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Slayer Task &amp; Status Effects">
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                            <TextBlock Text="Slayer Task:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="SlayerTaskText" Text="None" Foreground="#FFA726" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                            <TextBlock Text="Remaining / Master:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="SlayerRemainingText" Text="0" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                                            <TextBlock Text="Master:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="SlayerMasterText" Text="None" Foreground="#CCCCCC" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
                                            <TextBlock Text="Weight:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="PlayerWeightText" Text="0 kg" Foreground="#CCCCCC" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#252535" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock x:Name="PoisonStatusText" Text="Poison: Normal" Foreground="#A0A0B0" FontSize="10"/>
                                            </Border>
                                            <Border Background="#252535" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock x:Name="VenomStatusText" Text="Venom: None" Foreground="#A0A0B0" FontSize="10"/>
                                            </Border>
                                            <Border Background="#252535" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                <TextBlock x:Name="FreezeStatusText" Text="Freeze: None" Foreground="#A0A0B0" FontSize="10"/>
                                            </Border>
                                            <Border Background="#252535" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="VengeanceStatusText" Text="Veng: Inactive" Foreground="#A0A0B0" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="CombatTargetText" Text=""/>
                                    <TextBlock x:Name="PlayerInteractingText" Text=""/>
                                    <TextBlock x:Name="PlayerSlayerText" Text=""/>
                                    <TextBlock x:Name="PlayerDialogBadgeText" Text=""/>
                                    <Border x:Name="PlayerDialogBadge"/>
                                    <TextBlock x:Name="PlayerAgilityText" Text=""/>
                                    <TextBlock x:Name="PlayerMinigameText" Text=""/>
                                    <TextBlock x:Name="PlayerFishingText" Text=""/>
                                    <TextBlock x:Name="AutocastSpellText" Text=""/>
                                    <TextBlock x:Name="SpecialAttackStatusText" Text=""/>
                                    <TextBlock x:Name="SpellbookText" Text=""/>
                                    <Border x:Name="AutocastBadge"/>
                                    <TextBlock x:Name="SelectedSpellText" Text=""/>
                                    <TextBlock x:Name="ActivePrayersListText" Text=""/>
                                    <TextBlock x:Name="ActivePrayerCountText" Text=""/>
                                    <TextBlock x:Name="SlayerPointsText" Text=""/>
                                    <TextBlock x:Name="SlayerStreakText" Text=""/>
                                    <TextBlock x:Name="SlayerMasterNearbyText" Text=""/>
                                    <TextBlock x:Name="FishingSpotsSummaryText" Text=""/>
                                    <TextBlock x:Name="AgilityCourseLevelText"/>
                                    <TextBlock x:Name="AgilityCourseText"/>
                                    <Border x:Name="AiAssistantPanel"/>
                                    <TextBox x:Name="AiScriptInputBox"/>
                                    <TextBlock x:Name="BuffAntifireText"/>
                                    <TextBlock x:Name="BuffChargeText"/>
                                    <TextBlock x:Name="BuffDivineText"/>
                                    <TextBlock x:Name="BuffHeartText"/>
                                    <TextBlock x:Name="BuffOverloadText"/>
                                    <TextBlock x:Name="BuffPoisonText"/>
                                    <TextBlock x:Name="BuffPrayerEnhanceText"/>
                                    <TextBlock x:Name="BuffStaminaText"/>
                                    <TextBlock x:Name="BuffTogglesText"/>
                                    <TextBlock x:Name="MarksOfGraceText"/>
                                    <Border x:Name="MinigameActiveBadge"/>
                                    <TextBlock x:Name="MinigameActiveText"/>
                                    <TextBlock x:Name="MinigameExtraText"/>
                                    <TextBlock x:Name="MinigameNameText"/>
                                    <TextBlock x:Name="MinigamePointsText"/>
                                    <TextBlock x:Name="MinigameStatusText"/>
                                    <Border x:Name="QuickPrayerBadge"/>
                                    <TextBlock x:Name="QuickPrayerText"/>
                                    <TextBlock x:Name="SlayerCountText"/>
                                    <Border x:Name="SpecActiveBadge"/>
                                    <TextBlock x:Name="SpecActiveText"/>
                                    <TextBlock x:Name="SpecPercentText"/>
                                    <ProgressBar x:Name="SpecProgressBar"/>
                                    <Border x:Name="SpellbookBadge"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Equipment Paperdoll -->
                        <GroupBox Grid.Column="1" Header="Equipped Gear">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="46"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Head -->
                                <Border x:Name="Equip_Head" Grid.Row="0" Grid.Column="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>

                                <!-- Row 1: Cape, Neck, Ammo -->
                                <Border x:Name="Equip_Cape" Grid.Row="1" Grid.Column="0" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                                <Border x:Name="Equip_Neck" Grid.Row="1" Grid.Column="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                                <Border x:Name="Equip_Ammo" Grid.Row="1" Grid.Column="2" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>

                                <!-- Row 2: Weapon, Body, Shield -->
                                <Border x:Name="Equip_Weapon" Grid.Row="2" Grid.Column="0" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                                <Border x:Name="Equip_Body" Grid.Row="2" Grid.Column="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                                <Border x:Name="Equip_Shield" Grid.Row="2" Grid.Column="2" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>

                                <!-- Row 3: Legs -->
                                <Border x:Name="Equip_Legs" Grid.Row="3" Grid.Column="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>

                                <!-- Row 4: Hands, Feet, Ring -->
                                <Border x:Name="Equip_Hands" Grid.Row="4" Grid.Column="0" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                                <Border x:Name="Equip_Feet" Grid.Row="4" Grid.Column="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                                <Border x:Name="Equip_Ring" Grid.Row="4" Grid.Column="2" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Margin="2"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Bottom: Dialogue Card -->
                    <Border Grid.Row="2" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DialogTypeBadge" Grid.Column="0" Background="#141418" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                    <TextBlock x:Name="DialogTypeText" Text="No Active Dialogue" Foreground="#8E8E9E" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="DialogTitleText" Grid.Column="1" Text="" Foreground="#FFD700" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="DialogContentText" Text="No dialogue currently active in the client." Foreground="#D0D0D8" FontSize="11" TextWrapping="Wrap" MinHeight="24"/>
                            <StackPanel x:Name="DialogOptionsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                <TextBlock Text="Dialogue Options:" Foreground="#8E8E9E" FontSize="10" Margin="0,0,0,2"/>
                                <Border Background="#182535" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="6">
                                    <TextBlock x:Name="DialogOptionsText" Text="" Foreground="#00E5FF" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SKILLS TRACKER -->
            <TabItem Header="Skills &amp; XP">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Session Overview Strip -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Total Level" Foreground="#8E8E9E" FontSize="10"/>
                                <TextBlock x:Name="SkillsTotalLevelText" Text="0" Foreground="#00E5FF" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Total XP" Foreground="#8E8E9E" FontSize="10"/>
                                <TextBlock x:Name="SkillsTotalXpText" Text="0 XP" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="XP Gained" Foreground="#8E8E9E" FontSize="10"/>
                                <TextBlock x:Name="SkillsGainedText" Text="+0 XP" Foreground="#34D399" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <StackPanel>
                                <TextBlock Text="XP / Hour" Foreground="#8E8E9E" FontSize="10"/>
                                <TextBlock x:Name="SkillsRateText" Text="0 XP/hr" Foreground="#FBBF24" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter Strip -->
                    <Border Grid.Row="1" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Skill Category Filter:" Foreground="#8E8E9E" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <ComboBox x:Name="SkillFilterBox" SelectionChanged="SkillFilterBox_SelectionChanged" Width="140">
                                    <ComboBoxItem Content="All Skills" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Active Gaining" Tag="Active"/>
                                    <ComboBoxItem Content="Combat" Tag="Combat"/>
                                    <ComboBoxItem Content="Gathering" Tag="Gathering"/>
                                    <ComboBoxItem Content="Artisan" Tag="Artisan"/>
                                    <ComboBoxItem Content="Support" Tag="Support"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Reset Session" Click="ResetSkillTracker_Click" Background="#8B1E1E" Padding="8,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Skills Grid View -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SkillsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Width="210" Margin="4" Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Skill Name & Level -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#00E5FF" FontSize="12"/>
                                                <TextBlock Text="{Binding Level, StringFormat='Lvl {0}'}" FontWeight="ExtraBold" Foreground="#FFD700" FontSize="12" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Foreground="#34D399" Background="#141418" BorderThickness="0" Margin="0,0,0,4"/>

                                            <!-- XP Info -->
                                            <Grid Grid.Row="2">
                                                <TextBlock Text="{Binding CurrentXp, StringFormat='{}{0:N0} XP'}" Foreground="#A0A0B0" FontSize="9"/>
                                                <TextBlock Text="{Binding XpPerHour, StringFormat='{}{0:N0} XP/hr'}" Foreground="#60A5FA" FontSize="9" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: WORLD & ENTITIES -->
            <TabItem Header="World &amp; Entities">
                <TabControl Background="#1C1C24" BorderBrush="#323240" Margin="5">
                    <TabItem Header="NPCs">
                        <ListView x:Name="NpcList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="110"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Health" DisplayMemberBinding="{Binding Health}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Players">
                        <ListView x:Name="PlayerList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Combat" DisplayMemberBinding="{Binding CombatLevel}" Width="65"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Trees">
                        <ListView x:Name="TreesList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Tree Type" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="85"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Mining Rocks">
                        <ListView x:Name="RocksList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Rock Type" DisplayMemberBinding="{Binding Name}" Width="150"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Ground Items">
                        <ListView x:Name="GroundItemsList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                                    <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                    <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" Width="80"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Banks">
                        <ListView x:Name="BanksList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Bank Object" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Stores">
                        <ListView x:Name="ShopsList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Shop / Stall" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Altars &amp; Pools">
                        <ListView x:Name="AltarsList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Object Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- TAB 4: AGILITY & MINIGAMES -->
            <TabItem Header="Agility &amp; Minigames">
                <TabControl Background="#1C1C24" BorderBrush="#323240" Margin="5">
                    <TabItem Header="Shortcuts">
                        <ListView x:Name="ShortcutsList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Shortcut" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Req Level" DisplayMemberBinding="{Binding ReqLevel}" Width="75"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Course Obstacles">
                        <ListView x:Name="AgilityObstaclesList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Obstacle" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Course" DisplayMemberBinding="{Binding Course}" Width="150"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Fishing Spots">
                        <ListView x:Name="FishingSpotsList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                    <GridViewColumn Header="Spot Name" DisplayMemberBinding="{Binding Name}" Width="160"/>
                                    <GridViewColumn Header="Fish Types" DisplayMemberBinding="{Binding FishType}" Width="180"/>
                                    <GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance}" Width="65"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Location}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Minigames Tracker">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <GroupBox Header="Barrows">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Brothers Defeated:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="BarrowsBrothersDefeatedText" Text="0 / 6" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Reward Potential:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="BarrowsRewardPotText" Text="0%" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Chest Found:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="BarrowsChestFoundText" Text="No" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Wintertodt &amp; Tempoross">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="WT Warmth / Score:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="WintertodtWarmthText" Text="Warmth: 100%" Foreground="#60A5FA" FontSize="11"/>
                                            <TextBlock x:Name="WintertodtScoreText" Text="Score: 0" Foreground="#FFD700" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="WT Brazier:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="WintertodtBrazierText" Text="Lit" Foreground="#34D399" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tempoross Energy:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="TemporossEnergyText" Text="100%" Foreground="#00E5FF" FontSize="11"/>
                                            <TextBlock x:Name="TemporossEssenceText" Text="Ess: 100%" Foreground="#60A5FA" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Tempoross Storm:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="TemporossStormText" Text="0%" Foreground="#F87171" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Nightmare Zone, Blast Furnace &amp; Tithe Farm">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="NMZ Points / Absorb:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="NmzPointsText" Text="0 Points" Foreground="#FFD700" FontSize="11"/>
                                            <TextBlock x:Name="NmzAbsorptionText" Text="Absorb: 0" Foreground="#34D399" FontSize="11"/>
                                            <TextBlock x:Name="NmzOverloadText" Text="Overload: None" Foreground="#A0A0B0" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Blast Furnace:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="BlastFurnaceCofreText" Text="Coins: 0" Foreground="#FFD700" FontSize="11"/>
                                            <TextBlock x:Name="BlastFurnaceOreText" Text="Ore: 0" Foreground="White" FontSize="11"/>
                                            <TextBlock x:Name="BlastFurnaceBarText" Text="Bars: 0" Foreground="#34D399" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Tithe &amp; GOTR:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="TithePointsText" Text="Tithe: 0" Foreground="#34D399" FontSize="11"/>
                                            <TextBlock x:Name="GotrRiftEnergyText" Text="GOTR: 0%" Foreground="#00E5FF" FontSize="11"/>
                                            <TextBlock x:Name="TitheFertilizerText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="TitheWaterText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GotrCatalyticText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GotrElementalText" Text="" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <ListView x:Name="WorldShortcutsList" Visibility="Collapsed"/>
                                <ListView x:Name="WorldAgilityObstaclesList" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- TAB 5: BANK & CONTAINERS -->
            <TabItem Header="Bank &amp; Economy">
                <TabControl Background="#1C1C24" BorderBrush="#323240" Margin="5">
                    <TabItem Header="Bank Contents">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border x:Name="BankOpenBadge" Background="#2A2A35" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock x:Name="BankOpenText" Text="Bank Closed" Foreground="#8E8E9E" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="BankItemCountText" Text="0 Items Stored" Foreground="#00E5FF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                            <ListView x:Name="BankContainerList" Grid.Row="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                                        <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="220"/>
                                        <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Shop Interface">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Border x:Name="ShopOpenBadge" Background="#2A2A35" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock x:Name="ShopOpenText" Text="Shop Closed" Foreground="#8E8E9E" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock x:Name="ShopTitleText" Text="Shop" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ShopItemCountText" Text="0 Items" Foreground="#FFD700" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <ListView x:Name="ShopContainerList" Grid.Row="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                                        <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="220"/>
                                        <GridViewColumn Header="Stock Quantity" DisplayMemberBinding="{Binding Quantity}" Width="100"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Grand Exchange">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GeOffersControl" Margin="5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Width="240" Margin="4" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding State, StringFormat='Slot {0}'}" FontWeight="Bold" Foreground="#00E5FF" FontSize="11"/>
                                                <TextBlock Grid.Row="1" Text="{Binding ItemName}" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,2"/>
                                                <TextBlock Grid.Row="2" Text="{Binding ProgressText}" Foreground="#A0A0B0" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Containers &amp; Pouches">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <!-- Rune Pouch -->
                                <GroupBox Header="Rune Pouch">
                                    <ItemsControl x:Name="RunePouchControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4" Width="140">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RuneName}" FontWeight="Bold" Foreground="#00E5FF" FontSize="11"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}'}" Foreground="#FFD700" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <!-- Gem Bag & Essence Pouches -->
                                <GroupBox Header="Gem Bag &amp; Essence Pouches">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Gem Bag Total:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="GemBagTotalText" Text="0" Foreground="#FFD700" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="GemBagSapphireText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GemBagEmeraldText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GemBagRubyText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GemBagDiamondText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GemBagDragonstoneText" Text="" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Essence Pouches Total:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="EssPouchTotalText" Text="0" Foreground="#00E5FF" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock x:Name="EssPouchSmallText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="EssPouchMedText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="EssPouchLargeText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="EssPouchGiantText" Text="" Visibility="Collapsed"/>
                                            <TextBlock x:Name="EssPouchColossalText" Text="" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Looting Bag -->
                                <GroupBox Header="Looting Bag Contents">
                                    <ListView x:Name="LootingBagContainerList" MinHeight="100">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                                                <GridViewColumn Header="Item Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                                <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" Width="90"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- TAB 6: PRAYERS & MAGIC -->
            <TabItem Header="Prayers &amp; Magic">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Prayers &amp; Quick Prayers" Foreground="#00E5FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PrayersControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="4" Width="150" Margin="4" Padding="8">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding TextBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding LevelReq, StringFormat='Lvl {0}'}" Foreground="#8E8E9E" FontSize="9" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 7: BOT & SCRIPT STUDIO -->
            <TabItem Header="Bot &amp; Scripts">
                <TabControl Background="#1C1C24" BorderBrush="#323240" Margin="5">
                    <!-- Bot Controller -->
                    <TabItem Header="Bot Controller">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- Bot Status Banner -->
                                <Border x:Name="BotStatusBadge" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Bot Execution Status" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBlock x:Name="BotStatusText" Text="STOPPED" Foreground="#E57373" FontWeight="Bold" FontSize="16" Margin="0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="BotTaskText" Text="Task: Idle" Foreground="#A0A0B0" FontSize="11" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="BotCyclesText" Text="0 cycles" Foreground="#8E8E9E" FontSize="11" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="BotRuntimeText" Text="00:00:00" Foreground="#00E5FF" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="StartBotBtn" Content="▶ Start Bot" Click="StartBotBtn_Click" Background="#287233" Foreground="White" FontWeight="Bold" Padding="14,8" Margin="0,0,4,0"/>
                                            <Button x:Name="PauseBotBtn" Content="⏸ Pause" Click="PauseBotBtn_Click" Background="#9E7A00" Foreground="White" FontWeight="Bold" Padding="12,8" Margin="0,0,4,0" IsEnabled="False"/>
                                            <Button x:Name="StopBotBtn" Content="⏹ Stop" Click="StopBotBtn_Click" Background="#8B1E1E" Foreground="White" FontWeight="Bold" Padding="12,8" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Configuration Selectors -->
                                <GroupBox Header="Automation Bot Selection">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Select Active Bot:" Foreground="#00E5FF" FontSize="11" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="BotSelectorComboBox" SelectionChanged="BotSelectorComboBox_SelectionChanged" Width="Auto" HorizontalAlignment="Stretch"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button x:Name="PopoutCurrentScriptBtn" Content="Popout Dashboard" Click="PopoutCurrentScriptBtn_Click" Padding="8,4" Margin="0,0,4,0"/>
                                            <Button Content="Open Script Studio" Click="OpenScriptStudioBtn_Click" Background="#007ACC" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Bot Console Log -->
                                <GroupBox Header="Bot Output Console" Margin="0,5,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="BotConsoleTextBox" Grid.Row="0" Background="#141418" Foreground="#A0E0A0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                                        <Button Content="Clear Console" Click="ClearBotConsole_Click" HorizontalAlignment="Right" Padding="8,2" Margin="0,4,0,0"/>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Script Studio / Creator -->
                    <TabItem Header="Script Creator" x:Name="ScriptCreatorTab">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Script Metadata -->
                            <Border Grid.Row="0" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Script Name:" Foreground="#8E8E9E" FontSize="10"/>
                                        <TextBox x:Name="CreatorScriptNameBox" Text="MyCustomScript" Background="#141418" Foreground="White" BorderBrush="#454558" Padding="4,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="Category:" Foreground="#8E8E9E" FontSize="10"/>
                                        <ComboBox x:Name="CreatorCategoryComboBox" Width="Auto" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Woodcutting" IsSelected="True"/>
                                            <ComboBoxItem Content="Mining"/>
                                            <ComboBoxItem Content="Combat"/>
                                            <ComboBoxItem Content="Fishing"/>
                                            <ComboBoxItem Content="Banking"/>
                                            <ComboBoxItem Content="Agility"/>
                                            <ComboBoxItem Content="Magic"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                        <TextBlock Text="Saved Scripts:" Foreground="#8E8E9E" FontSize="10"/>
                                        <ComboBox x:Name="SavedScriptsComboBox" SelectionChanged="SavedScriptsComboBox_SelectionChanged" Width="Auto" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Content="Del Script" Click="DeleteSavedScriptBtn_Click" Background="#8B1E1E" Padding="6,4" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CreatorTemplatesComboBox" Width="130" Margin="0,0,4,0">
                                            <ComboBoxItem Content="Chop Oak and Bank" IsSelected="True"/>
                                            <ComboBoxItem Content="Mine Iron and Drop"/>
                                            <ComboBoxItem Content="Goblin Fighter"/>
                                        </ComboBox>
                                        <Button Content="Load Template" Click="LoadTemplateBtn_Click" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Loot & Target Config -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" Header="Nearby Monsters" Margin="0,0,3,0">
                                    <StackPanel>
                                        <ListBox x:Name="CreatorNearbyNpcsList" Height="70" SelectionChanged="CreatorNearbyNpcsList_SelectionChanged" Background="#141418"/>
                                        <Button Content="Scan Nearby" Click="CreatorScanNearbyNpcs_Click" Padding="4,2" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="Monster Drops" Margin="2,0,2,0">
                                    <StackPanel>
                                        <ListBox x:Name="CreatorLootTableList" Height="70" SelectionMode="Extended" Background="#141418"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                            <Button Content="+ Select" Click="CreatorAddSelectedLoot_Click" Padding="4,2"/>
                                            <Button Content="+ Herbs" Click="CreatorAddHerbsLoot_Click" Padding="4,2"/>
                                            <Button Content="+ 100%" Click="CreatorAddAlwaysLoot_Click" Padding="4,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Column="2" Header="Active Loot List" Margin="3,0,0,0">
                                    <StackPanel>
                                        <ListBox x:Name="CreatorActiveLootList" Height="70" Background="#141418"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CreatorCustomLootBox" Background="#141418" Foreground="White" BorderBrush="#454558" Margin="0,0,2,0"/>
                                            <Button Grid.Column="1" Content="Add" Click="CreatorAddCustomLootItem_Click" Padding="4,2" Margin="0,0,2,0"/>
                                            <Button Grid.Column="2" Content="Del" Click="CreatorRemoveLootItem_Click" Background="#8B1E1E" Padding="4,2" Margin="0,0,2,0"/>
                                            <Button Grid.Column="3" Content="To Steps" Click="CreatorApplyCombatLootToSteps_Click" Background="#007ACC" Padding="4,2"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <!-- Steps Sequence & Action Editor -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Steps List -->
                                <GroupBox Grid.Column="0" Header="Script Steps Sequence" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ListBox x:Name="CreatorStepsListBox" SelectionChanged="CreatorStepsListBox_SelectionChanged" Background="#141418">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="1" Padding="4,2" Background="#262634" CornerRadius="3">
                                                        <TextBlock Text="{Binding Title}" Foreground="#00E5FF" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="▲" Click="MoveUpStepBtn_Click" Padding="6,2"/>
                                            <Button Content="▼" Click="MoveDownStepBtn_Click" Padding="6,2"/>
                                            <Button Content="Del" Click="DeleteStepBtn_Click" Background="#8B1E1E" Padding="6,2"/>
                                            <Button Content="Clear" Click="ClearStepsBtn_Click" Padding="6,2"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Step Config -->
                                <GroupBox Grid.Column="1" Header="Step Editor" Margin="4,0,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Title:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBox x:Name="StepTitleBox" Text="Chop Tree" Background="#141418" Foreground="White" BorderBrush="#454558" Margin="0,0,0,4"/>

                                            <TextBlock Text="Condition &amp; Parameter:" Foreground="#8E8E9E" FontSize="10"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="StepConditionComboBox" Width="Auto" HorizontalAlignment="Stretch" Margin="0,0,2,0">
                                                    <ComboBoxItem Content="Always" IsSelected="True"/>
                                                    <ComboBoxItem Content="If Inventory Full"/>
                                                    <ComboBoxItem Content="If Inventory Not Full"/>
                                                    <ComboBoxItem Content="If Has Item in Inv"/>
                                                    <ComboBoxItem Content="If Does NOT Have Item"/>
                                                    <ComboBoxItem Content="If Player is Idle"/>
                                                    <ComboBoxItem Content="If Player Animating"/>
                                                    <ComboBoxItem Content="If HP % Below"/>
                                                    <ComboBoxItem Content="If Prayer Below"/>
                                                    <ComboBoxItem Content="If Bank is Open"/>
                                                    <ComboBoxItem Content="If Bank is Closed"/>
                                                    <ComboBoxItem Content="If Dialog Open"/>
                                                </ComboBox>
                                                <TextBox x:Name="StepConditionArgBox" Grid.Column="1" Background="#141418" Foreground="White" BorderBrush="#454558" Margin="2,0,0,0"/>
                                            </Grid>

                                            <TextBlock Text="Action Type:" Foreground="#8E8E9E" FontSize="10"/>
                                            <ComboBox x:Name="StepActionTypeComboBox" SelectionChanged="StepActionTypeComboBox_SelectionChanged" Width="Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                                <ComboBoxItem Content="Chop Tree / Object" IsSelected="True"/>
                                                <ComboBoxItem Content="Mine Rock"/>
                                                <ComboBoxItem Content="Click / Interact Object"/>
                                                <ComboBoxItem Content="Attack NPC"/>
                                                <ComboBoxItem Content="Talk to NPC"/>
                                                <ComboBoxItem Content="Drop Item"/>
                                                <ComboBoxItem Content="Use Item On Object"/>
                                                <ComboBoxItem Content="Use Item On Item"/>
                                                <ComboBoxItem Content="Cast Spell"/>
                                                <ComboBoxItem Content="Walk to Tile"/>
                                                <ComboBoxItem Content="Bank Deposit All"/>
                                                <ComboBoxItem Content="Bank Deposit Except"/>
                                                <ComboBoxItem Content="Bank Withdraw Item"/>
                                                <ComboBoxItem Content="Open Nearest Bank"/>
                                                <ComboBoxItem Content="Close Bank / Interface"/>
                                                <ComboBoxItem Content="Loot Ground Item"/>
                                                <ComboBoxItem Content="Run Agility Obstacle"/>
                                                <ComboBoxItem Content="Continue Dialog"/>
                                                <ComboBoxItem Content="Select Dialog Option"/>
                                                <ComboBoxItem Content="Wait Seconds / Sleep"/>
                                                <ComboBoxItem Content="Wait For Idle"/>
                                            </ComboBox>

                                            <TextBlock x:Name="StepTargetLabel" Text="Target Object / NPC / Item:" Foreground="#8E8E9E" FontSize="10"/>
                                            <TextBox x:Name="StepTargetNameBox" Text="Tree" Background="#141418" Foreground="White" BorderBrush="#454558" Margin="0,0,0,4"/>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                                    <TextBlock x:Name="StepVerbLabel" Text="Action Verb:" Foreground="#8E8E9E" FontSize="10"/>
                                                    <TextBox x:Name="StepActionVerbBox" Text="Chop down" Background="#141418" Foreground="White" BorderBrush="#454558"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                                    <TextBlock x:Name="StepParam1Label" Text="Param / Option:" Foreground="#8E8E9E" FontSize="10"/>
                                                    <TextBox x:Name="StepParam1Box" Text="" Background="#141418" Foreground="White" BorderBrush="#454558"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="2,0,0,0">
                                                    <TextBlock Text="Wait After (ms):" Foreground="#8E8E9E" FontSize="10"/>
                                                    <TextBox x:Name="StepWaitBox" Text="1200" Background="#141418" Foreground="White" BorderBrush="#454558"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Update Step" Click="UpdateStepBtn_Click" Background="#287233" Padding="8,3" Margin="0,0,3,0"/>
                                                <Button Content="+ Add Step" Click="AddStepBtn_Click" Background="#007ACC" Padding="8,3"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>

                            <!-- Script File Actions & Banking Helpers -->
                            <Border Grid.Row="3" Background="#22222E" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Banking Helper:" Foreground="#FFD700" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="QuickBankingOptionsComboBox" Width="140" Margin="0,0,3,0">
                                            <ComboBoxItem Content="Open Nearest Bank" IsSelected="True"/>
                                            <ComboBoxItem Content="Bank: Deposit All Items"/>
                                            <ComboBoxItem Content="Bank: Deposit All Except Tools"/>
                                            <ComboBoxItem Content="Bank: Deposit Equipment"/>
                                            <ComboBoxItem Content="Bank: Withdraw Item"/>
                                            <ComboBoxItem Content="Bank: Withdraw ALL"/>
                                            <ComboBoxItem Content="Bank: Close Interface"/>
                                        </ComboBox>
                                        <Button Content="+ Bank Step" Click="AddQuickBankingStep_Click" Padding="6,2"/>
                                        <ComboBox x:Name="QuickBankingPresetsComboBox" Width="140" Margin="6,0,3,0">
                                            <ComboBoxItem Content="Full Bank (Open -> Deposit All -> Close)" IsSelected="True"/>
                                            <ComboBoxItem Content="Keep Tools (Open -> Deposit All Except -> Close)"/>
                                            <ComboBoxItem Content="Combat Restock (Open -> Deposit Loot -> Withdraw Food -> Close)"/>
                                        </ComboBox>
                                        <Button Content="Insert Routine" Click="InsertBankingRoutineBtn_Click" Padding="6,2"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBox x:Name="CreatorDescBox" Text="" Visibility="Collapsed"/>
                                        <TextBox x:Name="CreatorMinDelayBox" Text="600" Visibility="Collapsed"/>
                                        <TextBox x:Name="CreatorMaxDelayBox" Text="1200" Visibility="Collapsed"/>
                                        <Button Content="Save Script" Click="SaveScriptBtn_Click" Background="#287233" Padding="8,3" Margin="0,0,3,0"/>
                                        <Button Content="Export .cs" Click="ExportCSharpBtn_Click" Background="#007ACC" Padding="8,3" Margin="0,0,3,0"/>
                                        <Button Content="Popout Creator" Click="PopoutCreatorScriptBtn_Click" Padding="8,3"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- TAB 8: RAW DATA & DIAGNOSTICS -->
            <TabItem Header="Raw Data">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Clear Logs" Click="ClearLogs_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button Content="Restart Hook" Click="RestartHook_Click" Padding="8,3"/>
                    </StackPanel>

                    <ListView x:Name="DataList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Property Key" DisplayMemberBinding="{Binding Key}" Width="200"/>
                                <GridViewColumn Header="Decoded Value" DisplayMemberBinding="{Binding Value}" Width="450"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- RIGHT SIDE: LIVE INVENTORY (4x7 Grid) & QUICK VITALS -->
        <Border Grid.Row="1" Grid.Column="1" Background="#1C1C24" BorderBrush="#323240" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Inventory Header with Real-time Slot Count -->
                <Border Grid.Row="0" Background="#252535" BorderBrush="#383848" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎒 " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Inventory" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#141418" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="InventoryCountText" Text="0 / 28" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Responsive 4x7 Interactive Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="InventoryGrid" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
